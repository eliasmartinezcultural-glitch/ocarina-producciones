<!-- =====================================================
     SCRIPT DEL ARCHIVO
===================================================== -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        const searchInput =
            document.getElementById("archivoSearch");


        const cards =
            document.querySelectorAll(".archivo-card");


        const filters =
            document.querySelectorAll(".archivo-filter");


        const count =
            document.getElementById("archivoCount");


        const empty =
            document.getElementById("archivoEmpty");


        let currentFilter = "todos";



        function updateArchive() {

            const search =
                searchInput.value
                    .toLowerCase()
                    .trim();


            let visible = 0;


            cards.forEach(function (card) {


                const category =
                    card.dataset.category;


                const searchable =
                    card.dataset.search || "";


                const matchesCategory =
                    currentFilter === "todos"
                    ||
                    category === currentFilter;


                const matchesSearch =
                    searchable.includes(search);


                if (
                    matchesCategory
                    &&
                    matchesSearch
                ) {

                    card.classList.remove("hidden");

                    visible++;

                }

                else {

                    card.classList.add("hidden");

                }

            });


            count.textContent =
                visible +
                (
                    visible === 1
                    ? " registro"
                    : " registros"
                );


            if (visible === 0) {

                empty.classList.add("visible");

            }

            else {

                empty.classList.remove("visible");

            }

        }



        filters.forEach(function (filter) {

            filter.addEventListener(
                "click",
                function () {


                    filters.forEach(function (button) {

                        button.classList.remove("active");

                    });


                    filter.classList.add("active");


                    currentFilter =
                        filter.dataset.filter;


                    updateArchive();

                }

            );

        });



        searchInput.addEventListener(
            "input",
            updateArchive
        );


        updateArchive();

    }

);

</script>


