<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Archivo Ocarina | Historia, Memoria y Territorio
    </title>

    <meta
        name="description"
        content="Archivo Ocarina. Documentos, fotografías, audios, investigaciones y memoria de San Patricio del Chañar y su territorio."
    >

    <meta
        name="author"
        content="Ocarina Producciones · Elías Martínez"
    >

    <meta
        name="theme-color"
        content="#11110f"
    >

    <link
        rel="stylesheet"
        href="../style.css"
    >

    <style>

        /* =====================================================
           ARCHIVO OCARINA
           MÓDULO INDEPENDIENTE
        ===================================================== */

        .archivo-page {

            background: #e9e3d5;
            color: #11110f;
            min-height: 100vh;

        }


        /* =====================================================
           CABECERA
        ===================================================== */

        .archivo-header {

            background: #11110f;
            color: white;
            padding: 35px 0;

            border-bottom:
                1px solid rgba(255,255,255,.12);

        }


        .archivo-header-inner {

            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 30px;

        }


        .archivo-brand {

            font-size: .75rem;
            letter-spacing: .18em;
            font-weight: 700;

        }


        .archivo-back {

            font-size: .62rem;
            letter-spacing: .13em;
            text-transform: uppercase;

            color:
                rgba(255,255,255,.7);

            transition:
                opacity .3s ease;

        }


        .archivo-back:hover {

            opacity: 1;

        }


        /* =====================================================
           HERO
        ===================================================== */

        .archivo-hero {

            background: #11110f;
            color: white;

            padding:
                100px 0 120px;

        }


        .archivo-eyebrow {

            margin-bottom: 25px;

            font-size: .65rem;
            letter-spacing: .18em;

            color:
                rgba(255,255,255,.55);

        }


        .archivo-hero h1 {

            max-width: 850px;

            margin: 0;

            font-size:
                clamp(3.5rem, 9vw, 8rem);

            line-height: .88;

            font-weight: 400;

            letter-spacing: -.055em;

        }


        .archivo-hero h1 em {

            display: block;

            color: #d5cdbd;

        }


        .archivo-hero p {

            max-width: 620px;

            margin-top: 40px;

            color:
                rgba(255,255,255,.68);

            font-size: 1rem;

        }


        /* =====================================================
           NAVEGACIÓN DEL ARCHIVO
        ===================================================== */

        .archivo-tools {

            padding: 35px 0;

            background: #ded7c9;

            border-bottom:
                1px solid rgba(17,17,15,.12);

        }


        .archivo-tools-inner {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

        }


        .archivo-search {

            flex: 1;

        }


        .archivo-search input {

            width: 100%;

            min-height: 50px;

            padding: 0 18px;

            border:
                1px solid rgba(17,17,15,.25);

            background:
                rgba(255,255,255,.35);

            color: #11110f;

            outline: none;

        }


        .archivo-search input:focus {

            border-color:
                #11110f;

        }


        .archivo-count {

            white-space: nowrap;

            font-size: .65rem;

            letter-spacing: .1em;

            text-transform: uppercase;

            color: #68655e;

        }


        /* =====================================================
           CATEGORÍAS
        ===================================================== */

        .archivo-categories {

            padding: 35px 0 0;

        }


        .archivo-category-list {

            display: flex;

            flex-wrap: wrap;

            gap: 9px;

        }


        .archivo-filter {

            border:
                1px solid rgba(17,17,15,.22);

            background: transparent;

            padding:
                10px 15px;

            cursor: pointer;

            font-size: .62rem;

            letter-spacing: .11em;

            text-transform: uppercase;

            color: #11110f;

            transition:
                background .3s ease,
                color .3s ease;

        }


        .archivo-filter:hover,
        .archivo-filter.active {

            background: #11110f;

            color: white;

        }


        /* =====================================================
           CONTENIDO
        ===================================================== */

        .archivo-content {

            padding:
                80px 0 130px;

        }


        .archivo-section-title {

            margin-bottom: 45px;

        }


        .archivo-section-title span {

            display: block;

            margin-bottom: 12px;

            font-size: .62rem;

            letter-spacing: .16em;

            color: #77736b;

        }


        .archivo-section-title h2 {

            margin: 0;

            font-size:
                clamp(2.2rem, 5vw, 4.5rem);

            line-height: .95;

            font-weight: 400;

            letter-spacing: -.035em;

        }


        /* =====================================================
           GRID
        ===================================================== */

        .archivo-grid {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 18px;

        }


        /* =====================================================
           TARJETA
        ===================================================== */

        .archivo-card {

            position: relative;

            min-height: 390px;

            padding: 28px;

            background: #f0ebe0;

            border:
                1px solid rgba(17,17,15,.12);

            display: flex;

            flex-direction: column;

            transition:
                transform .4s cubic-bezier(.22,1,.36,1),
                background .4s ease;

        }


        .archivo-card:hover {

            transform:
                translateY(-5px);

            background: #f5f0e7;

        }


        .archivo-card.hidden {

            display: none;

        }


        .archivo-number {

            font-size: .62rem;

            letter-spacing: .14em;

            color: #77736b;

        }


        .archivo-type {

            margin-top: 55px;

            font-size: .58rem;

            letter-spacing: .14em;

            text-transform: uppercase;

            color: #77736b;

        }


        .archivo-card h3 {

            margin:
                12px 0 15px;

            font-size: 1.65rem;

            line-height: 1;

            font-weight: 400;

        }


        .archivo-card p {

            margin: 0;

            color: #6d6961;

            font-size: .88rem;

        }


        .archivo-meta {

            display: flex;

            flex-direction: column;

            gap: 4px;

            margin-top: auto;

            padding-top: 25px;

            border-top:
                1px solid rgba(17,17,15,.12);

        }


        .archivo-meta span {

            font-size: .62rem;

            color: #77736b;

        }


        .archivo-actions {

            display: flex;

            gap: 8px;

            margin-top: 20px;

        }


        .archivo-button {

            min-height: 42px;

            padding:
                0 15px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            border:
                1px solid rgba(17,17,15,.25);

            font-size: .59rem;

            letter-spacing: .1em;

            text-transform: uppercase;

            cursor: pointer;

            background: transparent;

            color: #11110f;

            transition:
                background .3s ease,
                color .3s ease;

        }


        .archivo-button:hover {

            background: #11110f;

            color: white;

        }


        /* =====================================================
           ESTADO VACÍO
        ===================================================== */

        .archivo-empty {

            display: none;

            padding:
                70px 20px;

            text-align: center;

            border:
                1px dashed rgba(17,17,15,.25);

            color: #77736b;

        }


        .archivo-empty.visible {

            display: block;

        }


        .archivo-empty strong {

            display: block;

            margin-bottom: 8px;

            color: #11110f;

        }


        /* =====================================================
           APORTE COMUNITARIO
        ===================================================== */

        .archivo-contribute {

            padding:
                100px 0;

            background: #11110f;

            color: white;

        }


        .archivo-contribute-grid {

            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 100px;

            align-items: center;

        }


        .archivo-contribute h2 {

            margin: 0;

            font-size:
                clamp(2.8rem, 6vw, 5.5rem);

            line-height: .92;

            font-weight: 400;

        }


        .archivo-contribute h2 em {

            display: block;

            color: #d5cdbd;

        }


        .archivo-contribute-copy {

            max-width: 520px;

        }


        .archivo-contribute-copy p {

            color:
                rgba(255,255,255,.68);

        }


        .archivo-note {

            margin-top: 30px;

            padding:
                18px;

            border:
                1px solid rgba(255,255,255,.14);

            font-size: .75rem;

            color:
                rgba(255,255,255,.55);

        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .archivo-footer {

            padding: 45px 0;

            background: #0d0d0b;

            color: white;

        }


        .archivo-footer-inner {

            display: flex;

            justify-content: space-between;

            gap: 30px;

        }


        .archivo-footer p {

            margin: 5px 0;

            font-size: .7rem;

            color: #77746d;

        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 900px) {

            .archivo-grid {

                grid-template-columns:
                    repeat(2, 1fr);

            }


            .archivo-contribute-grid {

                grid-template-columns: 1fr;

                gap: 45px;

            }

        }


        @media (max-width: 600px) {

            .archivo-header-inner,
            .archivo-tools-inner,
            .archivo-footer-inner {

                flex-direction: column;

                align-items: flex-start;

            }


            .archivo-hero {

                padding:
                    75px 0 90px;

            }


            .archivo-grid {

                grid-template-columns: 1fr;

            }


            .archivo-content {

                padding:
                    65px 0 90px;

            }


            .archivo-card {

                min-height: 360px;

            }


            .archivo-contribute {

                padding:
                    75px 0;

            }

        }

    </style>

</head>


